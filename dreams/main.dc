# main.dc
# 程序入口。梦的开始。
#
# 编译于潜意识，运行于不存在。

import dream;

fn compile(source) {
    print("[compile]", "image of", source);
    return "image:" + source;
}

fn run(image) {
    print("[run]", "executing", image, "in nonexistent");
    return {ok: true, image: image};
}

fn debug_dream(result) {
    print("[debug] not debugging, interpreting the dream instead");
}

fn commit(result) {
    print("[commit] sleep_commit: dream: " + result.image);
}

let result = run(compile("main.dc"));

if not result.ok {
    debug_dream(result);
}

commit(result);
dream.sleep(8);
dream.wake();
